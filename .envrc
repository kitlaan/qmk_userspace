export QMK_USERSPACE=$PWD
# Point a native CLI at the pinned submodule. The shim does not need this: it
# passes -e QMK_HOME itself, so this export cannot conflict with it.
export QMK_HOME=$PWD/qmk_firmware

# Shim `qmk` only when no native CLI exists. This runs before util/bin joins
# PATH, so `command -v qmk` sees only a real install and the shim can never
# shadow one. Install qmk on the host and the shim stops being used, with no
# edit here. The dockerenv/containerenv checks guard a container that has no
# native qmk but does have docker on PATH: without them, the shim would call
# docker from inside a container and start docker-in-docker.
if ! command -v qmk >/dev/null 2>&1 \
    && [ ! -f /.dockerenv ] && [ ! -f /run/.containerenv ] \
    && command -v docker >/dev/null 2>&1; then
    PATH_add util/bin
fi

source_env_if_exists .envrc.local
